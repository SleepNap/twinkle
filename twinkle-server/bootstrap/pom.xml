<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.gms</groupId>
        <artifactId>twinkle-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>twinkle-bootstrap</artifactId>
    <name>twinkle-bootstrap</name>
    <description>唯一 main：读 --profile 装配角色模块</description>

    <dependencies>
        <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-api</artifactId></dependency>
        <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-core</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-slf4j2-impl</artifactId><scope>runtime</scope></dependency>
        <!-- 公共底座 -->
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-net-netty</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-net-packet</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-plugin-api</artifactId>
        </dependency>

        <!-- 游戏域（频道进程） -->
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-domain-game</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-domain-script</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-wz-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-channel</artifactId>
        </dependency>

        <!-- 管理侧（管理进程） -->
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-coordinator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-login</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-http-api</artifactId>
        </dependency>
        <!-- Micronaut 运行时入口 -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-runtime</artifactId>
        </dependency>
        <!-- Jackson 数据绑定（HTTP 错误响应 JSON body provider 需要，single 档 HTTP 默认启用） -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-jackson-databind</artifactId>
        </dependency>
        <!-- application.yml 解析：Micronaut 4.0 起 SnakeYAML 不再是传递依赖，需显式引入（版本由 Micronaut platform BOM 管理） -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- packaging/build-release.ps1 先构建 Vite，再把生产前端嵌入同一份可执行 JAR。 -->
            <resource>
                <directory>${project.basedir}/../../twinkle-web/dist</directory>
                <targetPath>public</targetPath>
            </resource>
        </resources>
        <plugins>
            <!-- 所有角色共用同一份可执行制品；多进程来自多次启动，不是打出多份角色 jar。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <outputFile>${project.parent.basedir}/target/twinkle-server.jar</outputFile>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.gms.bootstrap.TwinkleApplication</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
