<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.gms</groupId>
        <artifactId>twinkle-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>twinkle-bootstrap</artifactId>
    <name>twinkle-bootstrap</name>
    <description>唯一 main：读 --profile 装配角色模块</description>

    <dependencies>
        <!-- 公共底座 -->
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-net-netty</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-net-packet</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-data</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-db-dialect</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-plugin-api</artifactId>
        </dependency>

        <!-- 游戏域（频道进程） -->
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-domain-game</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-domain-script</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-wz-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-channel</artifactId>
        </dependency>

        <!-- 管理侧（管理进程） -->
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-coordinator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-login</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-admin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-http-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-ai</artifactId>
        </dependency>

        <!-- Micronaut 运行时入口 -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-runtime</artifactId>
        </dependency>
        <!-- Jackson 数据绑定（HTTP 错误响应 JSON body provider 需要，single 档 HTTP 默认启用） -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-jackson-databind</artifactId>
        </dependency>
    </dependencies>
</project>
