<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.gms</groupId>
    <artifactId>twinkle-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>twinkle-server</name>
    <description>热更新、扩展性好的冒险岛后台（MapleStory v83 服务端）——Maven 多模块父工程</description>

    <modules>
        <!-- 公共底座（所有进程都要） -->
        <module>core</module>
        <module>net-packet</module>
        <module>net-netty</module>
        <module>db-dialect</module>
        <module>data</module>
        <module>plugin-api</module>
        <module>bootstrap</module>

        <!-- 游戏域（频道进程） -->
        <module>domain-game</module>
        <module>domain-script</module>
        <module>wz-provider</module>
        <module>channel</module>

        <!-- 管理侧（管理进程） -->
        <module>coordinator</module>
        <module>login</module>
        <module>admin</module>
        <module>http-api</module>
    </modules>

    <properties>
        <!-- 编译基线：JDK 锁定 Temurin 21（红线 16）。Maven 3.8.6 不支持 -Drelease 直接传给 annotation processor，
             统一用 maven.compiler.release，配合 -proc:full 让 Micronaut 注解处理器参与编译。 -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- ===== 依赖版本（M0 经 Maven Central 核证，2026-08）===== -->
        <!-- Micronaut：4.10 线最新（5.x 基线 Java 25，与红线 16 互斥，见 memory/m0-dependency-versions） -->
        <micronaut.platform.version>4.10.17</micronaut.platform.version>
        <!-- Micronaut core 线最新（注解处理器与 core 同版本线） -->
        <micronaut.version>4.10.26</micronaut.version>
        <micronaut.openapi.version>6.20.0</micronaut.openapi.version>
        <swagger.annotations.version>2.2.43</swagger.annotations.version>
        <!-- Netty：4.2 线最新（虚拟线程）。显式覆盖 platform BOM 管理的 4.2.16 -->
        <netty.version>4.2.17.Final</netty.version>

        <mybatis-flex.version>1.11.8</mybatis-flex.version>
        <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
        <postgresql.version>42.7.13</postgresql.version>
        <mysql-connector.version>9.7.0</mysql-connector.version>

        <!-- GraalVM JS：版本必须与 JDK 的 GraalVM compiler 精确匹配（红线 16 JDK 21）。
             当前 JDK 21.0.11（compiler 23.1.11）→ js-language 23.1.11（实测 engine=Oracle GraalVM 编译优化）。
             注意：25.2.4 属 JDK 25 系列，在 JDK 21 上降级解释执行；查版本用官方
             repo1.maven.org maven-metadata.xml（search.maven.org 索引滞后，勿信其 latest）。 -->
        <graalvm-js.version>23.1.11</graalvm-js.version>
        <log4j2.version>2.26.1</log4j2.version>
        <lombok.version>1.18.46</lombok.version>
        <bucket4j.version>8.19.0</bucket4j.version>
        <archunit.version>1.5.0</archunit.version>
        <junit.version>6.1.2</junit.version>
        <assertj.version>3.27.3</assertj.version>
        <awaitility.version>4.3.0</awaitility.version>

        <!-- Maven 插件版本 -->
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Micronaut 4.10 平台 BOM：统一管理 Micronaut 全家桶依赖版本 -->
            <dependency>
                <groupId>io.micronaut.platform</groupId>
                <artifactId>micronaut-platform</artifactId>
                <version>${micronaut.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- JUnit BOM -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- log4j2 BOM：2.26.1（3.0 仍为 beta，不采用） -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>${log4j2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Netty BOM：4.2 线最新 -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- ArchUnit：架构测试 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <!-- Awaitility：异步等待断言 -->
            <dependency>
                <groupId>org.awaitility</groupId>
                <artifactId>awaitility</artifactId>
                <version>${awaitility.version}</version>
            </dependency>
            <!-- Jakarta Inject（Singleton 等标准作用域注解，Micronaut 4 用）。platform BOM 不直接管理 -->
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>2.0.1</version>
            </dependency>

            <!-- 内部模块（供跨模块依赖时不再写版本） -->
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-net-packet</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-net-netty</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-db-dialect</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-data</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-plugin-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-bootstrap</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-domain-game</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-domain-script</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-wz-provider</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-channel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-coordinator</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-login</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.gms</groupId>
                <artifactId>twinkle-http-api</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 全模块统一依赖：log4j2（日志红线 9）+ JUnit 5 + AssertJ + ArchUnit（架构测试）。 -->
        <!-- Lombok（编码规范红线 11：可变实体类用 @Getter/@Setter 代替手写）：编译期注解处理，provided 不打进产物，2C2G 零运行时开销 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 全模块统一编译：release 21 + 参数名 + 注解处理 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>21</release>
                        <parameters>true</parameters>
                        <proc>full</proc>
                        <annotationProcessorPaths>
                            <!-- Lombok 必须放在最前：与其他注解处理器（Micronaut）共存时，Lombok 需先于生成新类型的处理器 -->
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>io.micronaut</groupId>
                                <artifactId>micronaut-inject-java</artifactId>
                                <version>${micronaut.version}</version>
                            </path>
                            <path>
                                <groupId>io.micronaut</groupId>
                                <artifactId>micronaut-graal</artifactId>
                                <version>${micronaut.version}</version>
                            </path>
                            <path>
                                <groupId>io.micronaut.openapi</groupId>
                                <artifactId>micronaut-openapi</artifactId>
                                <version>${micronaut.openapi.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <!-- 从 Micronaut Controller/DTO 编译期生成 OpenAPI，并生成 Swagger UI 静态页面。 -->
                            <arg>-Amicronaut.openapi.views.spec=swagger-ui.enabled=true</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <!-- 依赖单向无环：本模块只能依赖列出的模块 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!-- 红线 16：GraalVM JS 全速需 EnableJVMCI。EnableJVMCI 是实验选项，
                             需 UnlockExperimentalVMOptions 前置。JDK 21 Temurin 有效。
                             ${argLine} 由 JaCoCo prepare-agent 注入（覆盖率探针），此处仅追加 JVM 实验选项。 -->
                        <argLine>${argLine} -XX:+UnlockExperimentalVMOptions -XX:+EnableJVMCI</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-jdk21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.8,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo：测试覆盖率探针（prepare-agent 注入 + report 生成）。
                 仅出报告、不强制门禁，避免误伤；覆盖率门禁由团队后续按基线设定。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
