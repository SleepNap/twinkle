<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.gms</groupId><artifactId>twinkle-server</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>twinkle-login-logic</artifactId>
  <description>可替换游戏业务实现；宿主只依赖稳定调用契约</description>
  <dependencies><dependency><groupId>org.gms</groupId><artifactId>twinkle-login</artifactId></dependency></dependencies>
  <build><plugins><plugin>
    <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
    <executions><execution><id>logic-artifact</id><phase>process-classes</phase><goals><goal>java</goal></goals>
      <configuration><mainClass>org.gms.module.ModulePackager</mainClass><arguments>
        <argument>${project.build.outputDirectory}</argument><argument>${project.parent.basedir}/target/logic/login-logic.jar</argument>
        <argument>login-logic</argument><argument>org.gms.logic.login.ModuleFactory</argument><argument>org.gms.logic.login.</argument>
        <argument>org.gms.login.LoginService</argument>
      <argument>org.gms.hotreload.versioned.VersionGate,org.gms.persistence.repo.GameAccountRepository,org.gms.persistence.repo.InventoryItemRepository,org.gms.persistence.repo.PlayerCharacterRepository</argument></arguments></configuration>
    </execution></executions>
  </plugin></plugins></build>
</project>
