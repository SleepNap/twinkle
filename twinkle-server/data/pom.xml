<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.gms</groupId>
        <artifactId>twinkle-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>twinkle-data</artifactId>
    <name>twinkle-data</name>
    <description>MyBatis-Flex 映射 + Repository + 自研迁移器（Flyway 社区版不支持 SQLite，见 ARCHITECTURE.md 6.2 决策）</description>

    <dependencies>
        <!-- MyBatis-Flex 核心 -->
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-core</artifactId>
            <version>${mybatis-flex.version}</version>
        </dependency>
        <!-- SQLite JDBC（低配默认） -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>
        <!-- PostgreSQL JDBC（大服） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>
        <!-- MySQL JDBC（兼容切换） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector.version}</version>
        </dependency>
        <!-- 方言差异点统一入口 -->
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-db-dialect</artifactId>
        </dependency>
        <!-- 配置门面 + EventBus（实现 DbConfigFacade 需要的接口） -->
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-core</artifactId>
        </dependency>
        <!-- Micronaut 上下文（数据源生命周期管理） -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-context</artifactId>
        </dependency>
    </dependencies>
</project>
