<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.gms</groupId>
        <artifactId>twinkle-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>twinkle-net-netty</artifactId>
    <name>twinkle-net-netty</name>
    <description>Netty IO（客户端 v83 协议 + 内部通信复用，不依赖业务）</description>

    <dependencies>
        <!-- Netty 4.2（虚拟线程）：transport + codec + handler -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
        </dependency>
        <!-- v83 协议字节定义 -->
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-net-packet</artifactId>
        </dependency>
        <!-- 内部通信网络实现需 core 接口（EventBus / IntercoordService，铁律 1：接口在底座） -->
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-core</artifactId>
        </dependency>
        <!-- 内部帧负载 JSON 序列化（RPC 参数 / 事件 payload，版本由 micronaut-platform BOM 管理） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 集成测试引用 coordinator 进程内真值（CoordinatorService，仅 test scope 运行时；
             主依赖图仍为 base 模块纯净，ArchUnit 扫描排除测试类不违规则 5） -->
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-coordinator</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
