<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.gms</groupId>
        <artifactId>twinkle-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>twinkle-domain-script</artifactId>
    <name>twinkle-domain-script</name>
    <description>GraalVM 脚本引擎（宿主对象契约 cm/qm/em/rm/im 接口化）。独立库引入，配 EnableJVMCI 全速</description>

    <dependencies>
        <!-- GraalVM JS：org.graalvm.js:js 是 pom 聚合器（不含 jar），真正带语言实现的是
             js-language + truffle-runtime（Truffle 运行时）。js 聚合 POM 的依赖等价于显式引入这两个。
             版本须与 JDK 的 GraalVM compiler 精确匹配（红线 16 JDK 21：21.0.11 ↔ 23.1.11）。
             文档参见 https://www.graalvm.org/jdk21/reference-manual/embed-languages/ -->
        <dependency>
            <groupId>org.graalvm.js</groupId>
            <artifactId>js-language</artifactId>
            <version>${graalvm-js.version}</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.truffle</groupId>
            <artifactId>truffle-runtime</artifactId>
            <version>${graalvm-js.version}</version>
        </dependency>
        <!-- polyglot API（ScriptEngine 使用的 org.graalvm.polyglot.*） -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graalvm-js.version}</version>
        </dependency>
        <!-- 脚本引擎经配置门面/EventBus 与宿主交互 -->
        <dependency>
            <groupId>org.gms</groupId>
            <artifactId>twinkle-core</artifactId>
        </dependency>
    </dependencies>
</project>
